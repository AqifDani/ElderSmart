rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function getMyData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isFamilyMember(familyId) {
      return isSignedIn() && getMyData().familyId == familyId;
    }

    function isCaregiver() {
      let role = getMyData().role;
      return role == 'caregiver' || role == 'primary_caregiver';
    }

    function isPrimary() {
      return getMyData().role == 'primary_caregiver';
    }

    // --- 1. FAMILY CODES (Public Verification) ---
    match /families/{code} {
      allow get: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.primaryCaregiver == null ||
        resource.data.primaryCaregiver == request.auth.uid
      );
    }

    // --- 2. USER PROFILES ---
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId || 
        resource.data.familyId == getMyData().familyId
      );

      allow create: if isSignedIn() && request.auth.uid == userId;

      allow update: if isSignedIn() && (
        request.auth.uid == userId || 
        (isCaregiver() && get(/databases/$(database)/documents/users/$(userId)).data.familyId == getMyData().familyId)
      );
    }

    // --- 3. APPOINTMENTS ---
    match /appointments/{docId} {
      // Any family member can read their family's appointments
      allow read: if isFamilyMember(resource.data.familyId);

      // Only caregivers can create appointments, and the date must be present or future
      allow create: if isSignedIn() &&
                    isCaregiver() &&
                    request.resource.data.familyId == getMyData().familyId;

      // Any caregiver of the family can update (assign shifts, mark complete)
      allow update: if isCaregiver() &&
                    resource.data.familyId == getMyData().familyId;

      // Only the primary caregiver can delete appointments
      allow delete: if isPrimary() &&
                    resource.data.familyId == getMyData().familyId;
    }

    // --- 4. SHIFTS ---
    match /shifts/{docId} {
      allow read: if isFamilyMember(resource.data.familyId);

      allow create: if isSignedIn() &&
                    isCaregiver() &&
                    request.resource.data.familyId == getMyData().familyId;

      allow update: if isCaregiver() &&
                    resource.data.familyId == getMyData().familyId;

      allow delete: if isPrimary() &&
                    resource.data.familyId == getMyData().familyId;
    }


    // --- 6. HEALTH RECORDS ---
    match /health_records/{docId} {
      allow read: if isFamilyMember(resource.data.familyId);

      allow create: if isSignedIn() &&
                    isCaregiver() &&
                    request.resource.data.familyId == getMyData().familyId;

      allow update: if isCaregiver() &&
                    resource.data.familyId == getMyData().familyId;

      allow delete: if isPrimary() &&
                    resource.data.familyId == getMyData().familyId;
    }

    // --- 7. MEDICATIONS ---
    match /medications/{docId} {
      allow read: if isFamilyMember(resource.data.familyId) && (
        isCaregiver() || resource.data.elderId == request.auth.uid
      );

      allow create: if isSignedIn() &&
                    isCaregiver() &&
                    request.resource.data.familyId == getMyData().familyId;

      allow update: if isCaregiver() &&
                    resource.data.familyId == getMyData().familyId;

      allow delete: if isPrimary() &&
                    resource.data.familyId == getMyData().familyId;
    }

    // --- 8. MEDICATION LOGS ---
    // Exception: any family member can create logs (elders register their own intake)
    match /medication_logs/{docId} {
      allow read: if isFamilyMember(resource.data.familyId);

      allow create: if isSignedIn() &&
                    request.resource.data.familyId == getMyData().familyId;

      allow update: if isCaregiver() &&
                    resource.data.familyId == getMyData().familyId;

      allow delete: if isPrimary() &&
                    resource.data.familyId == getMyData().familyId;
    }

    // --- 9. NOTIFICATIONS ---
    // Any member can create (for elders' SOS). Read/update only by recipient or caregivers. Delete only by recipient or primary caregiver.
    match /notifications/{docId} {
      allow read: if isFamilyMember(resource.data.familyId) && (
        resource.data.recipientId == request.auth.uid ||
        !resource.data.recipientId ||
        isCaregiver()
      );

      allow create: if isSignedIn() &&
                    request.resource.data.familyId == getMyData().familyId;

      // Only the recipient can mark as read, or any caregiver of the family
      allow update: if isSignedIn() && resource.data.familyId == getMyData().familyId && (
        resource.data.recipientId == request.auth.uid ||
        isCaregiver()
      );

      // Only the recipient or the primary caregiver can delete
      allow delete: if isSignedIn() && resource.data.familyId == getMyData().familyId && (
        resource.data.recipientId == request.auth.uid ||
        isPrimary()
      );
    }


  }
}
