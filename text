/* =========================================
   19. CATCHY NOTIFICATIONS PAGE
   ========================================= */

/* css/style.css */

/* --- 1. Notification Feed Layout --- */
.notification-feed {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

/* --- 2. The Card Design --- */
.notification-card {
    background: white;
    padding: 16px 20px;
    border-radius: 12px;
    border-left: 5px solid #cbd5e1; /* Default Gray border */
    box-shadow: 0 2px 5px rgba(0,0,0,0.03);
    position: relative;
    overflow: hidden;
    transition: all 0.2s ease;
    /* Animation for entering */
    animation: slideInUpFade 0.5s ease-out forwards;
    opacity: 0; /* Start hidden for animation */
}

.notification-card:hover {
    transform: translateX(4px);
    box-shadow: 0 8px 16px rgba(0,0,0,0.06);
}

/* Animation Keyframes */
@keyframes slideInUpFade {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
}

/* --- 3. Variant Styles (Urgent vs Info) --- */
/* Urgent: Red Tint & Border */
.notification-card.urgent {
    border-left-color: var(--danger);
    background: #fff5f5; 
}

/* Info: Blue Tint & Border */
.notification-card.info {
    border-left-color: var(--info);
    background: white;
}

/* --- 4. Mark All Read Button --- */
#clearAllBtn {
    background: white;
    border: 1px solid var(--border);
    color: var(--text-main);
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
}
#clearAllBtn:hover {
    background: #f8fafc;
    border-color: var(--primary);
    color: var(--primary);
    transform: translateY(-1px);
}

/* --- 5. Empty State Styling --- */
.empty-state-container {
    text-align: center;
    padding: 60px;
    background: white;
    border-radius: 16px;
    border: 2px dashed #e2e8f0;
    margin-top: 20px;
}
.sleepy-bell {
    font-size: 60px;
    color: #cbd5e1;
    margin-bottom: 15px;
    animation: float 3s ease-in-out infinite;
}
@keyframes float {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
    100% { transform: translateY(0px); }
}

/* Delete Button Styling */
.delete-btn {
    background: transparent;
    border: none;
    font-size: 16px; /* Slightly larger icon */
    width: 32px;
    height: 32px;
    border-radius: 8px; /* Soft square looks better with the list */
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    color: #94a3b8; /* Default muted color */
}

.delete-btn:hover {
    background: #fee2e2;
    color: var(--danger);
    transform: scale(1.1);
}

/* Ensure the divider line matches the theme */
.border-l {
    border-left: 1px solid #e2e8f0;
}